# Official source artifacts must remain byte-identical for checksum validation.
# Treat source artifacts as binary so Git does not normalize CRLF TXT files
# or attempt text diffs for PDFs and archives. Keep source READMEs reviewable.
content/sources/** binary
content/sources/*.md -binary text eol=lf diff merge
content/sources/ised/*.md -binary text eol=lf diff merge
