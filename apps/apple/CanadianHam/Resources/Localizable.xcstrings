    "The receiving exam plays once without pause or replay, then gives a 2-minute review before grading. Results open on a separate screen after grading." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’examen de réception joue une seule fois, sans pause ni reprise, puis accorde une révision de 2 minutes avant la correction. Les résultats s’ouvrent sur un écran distinct après la correction."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’examen de réception joue une seule fois, sans pause ni reprise, puis accorde une révision de 2 minutes avant la correction. Les résultats s’ouvrent sur un écran distinct après la correction."
          }
        }
      }
    },
    "Theme" : {
