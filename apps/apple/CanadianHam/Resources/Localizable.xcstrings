    "Generate 100 shared-engine questions: one from each subsection, shuffled by seed. The optional timer is off by default.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Générez 100 questions avec le moteur partagé : une par sous-section, mélangées selon une graine. La minuterie facultative est désactivée par défaut."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Générez 100 questions avec le moteur partagé : une par sous-section, mélangées selon une graine. La minuterie facultative est désactivée par défaut."
