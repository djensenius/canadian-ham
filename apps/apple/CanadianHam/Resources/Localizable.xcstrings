    "%@. %@. Due review excludes unseen questions. Progress updates use the shared engine with an explicit timestamp." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@. %2$@. Due review excludes unseen questions. Progress updates use the shared engine with an explicit timestamp."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. %@. La révision due exclut les questions inédites. Les mises à jour de progression utilisent le moteur partagé avec un horodatage explicite."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
