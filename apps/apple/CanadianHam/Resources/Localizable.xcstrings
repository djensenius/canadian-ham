    "Canadian Ham is an independent study tool. It is not affiliated with, sponsored by, or endorsed by the Government of Canada, Innovation, Science and Economic Development Canada (ISED), Radio Amateurs of Canada (RAC), or any accredited examiner.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canadian Ham est un outil d’étude indépendant. Il n’est ni affilié au gouvernement du Canada, à Innovation, Sciences et Développement économique Canada (ISED), à Radio Amateurs du Canada (RAC) ou à un examinateur accrédité, ni commandité ou approuvé par eux."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Canadian Ham est un outil d’étude indépendant. Il n’est ni affilié au gouvernement du Canada, à Innovation, Sciences et Développement économique Canada (ISED), à Radio Amateurs du Canada (RAC) ou à un examinateur accrédité, ni commandité ou approuvé par eux."
          }
        }
      }
    },
    "Canadian Ham is independent and not affiliated with, sponsored by, or endorsed by ISED, RAC, or any accredited examiner.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canadian Ham est indépendant et n’est ni affilié à ISED, à RAC ou à un examinateur accrédité, ni commandité ou approuvé par eux."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Canadian Ham est indépendant et n’est ni affilié à ISED, à RAC ou à un examinateur accrédité, ni commandité ou approuvé par eux."
          }
        }
      }
    },
