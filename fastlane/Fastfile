require "fileutils"
require "shellwords"

opt_out_usage

default_platform(:ios)

API_KEY = {
  key_id: "XP65R4N5A2",
  issuer_id: "69a6de7e-a5f5-47e3-e053-5b8c7c11a4d1",
  key_filepath: File.expand_path("~/.appstoreconnect/AuthKey_XP65R4N5A2.p8")
}.freeze

TEAM_ID = "9JALHNGRBQ"
APP_NAME = "Canadian Ham"
APP_SKU = "canadian-ham"
PRIMARY_BUNDLE_ID = "org.davidjensenius.CanadianHam"
PRIMARY_LANGUAGE = "en-CA"
REPO_ROOT = File.expand_path("..", __dir__)
PROJECT_PATH = File.join(REPO_ROOT, "apps/apple/CanadianHam.xcodeproj")
EXPORT_OPTIONS_PLIST = File.join(REPO_ROOT, "fastlane/ExportOptions.plist")
DEVELOPER_DIR = "/Applications/Xcode.app/Contents/Developer"
# xcode-select on the build host points at the Command Line Tools. fastlane's
# Helper.xcode_path ignores DEVELOPER_DIR and reads `xcode-select -p`, so pilot
# cannot find xcodebuild/iTMSTransporter (nil xcode_version). Point fastlane at
# full Xcode for this process only instead of changing xcode-select system-wide.
ENV["DEVELOPER_DIR"] = DEVELOPER_DIR
FastlaneCore::Helper.define_singleton_method(:xcode_path) { "#{DEVELOPER_DIR}/" }
ARCHIVE_ROOT = File.join(REPO_ROOT, "fastlane/archives")
BUILD_ROOT = File.join(REPO_ROOT, "fastlane/builds")

# Default Release uploads carry no capabilities beyond the app's default
# entitlements. The off-by-default DebugCloudKit gate is not uploaded by these
# lanes. If that gated build is ever distributed later, the Developer Portal App
# ID will also need iCloud (CloudKit), Push Notifications and the
# iCloud.org.davidjensenius.CanadianHam container configured explicitly.
REQUIRED_CAPABILITIES = {}.freeze

XBUILD_AUTH_ARGS = [
  "-allowProvisioningUpdates",
  "-authenticationKeyPath", API_KEY[:key_filepath],
  "-authenticationKeyID", API_KEY[:key_id],
  "-authenticationKeyIssuerID", API_KEY[:issuer_id]
].freeze

# Dedicated signing keychain so any session on the build host (SSH, agents)
# can sign without the login keychain. One-time setup: docs/release/testflight.md.
# The password file holds a random password for this keychain only (not the
# login password); it must stay mode 600 and is never committed or printed.
BUILD_KEYCHAIN_PATH = File.expand_path("~/Library/Keychains/canadian-ham-build.keychain-db")
BUILD_KEYCHAIN_PASSWORD_FILE = File.expand_path("~/.appstoreconnect/build-keychain.pw")
CERT_OUTPUT_DIR = File.expand_path("~/.appstoreconnect/certs")

BETA_PLATFORMS = {
  ios: {
    scheme: "CanadianHam",
    destination: "generic/platform=iOS",
    artifact: :ipa,
    app_platform: "ios"
  },
  mac: {
    scheme: "CanadianHam",
    destination: "generic/platform=macOS",
    artifact: :pkg,
    app_platform: "osx",
    build_settings: %w[SDKROOT=macosx SUPPORTED_PLATFORMS=macosx]
  },
  appletvos: {
    scheme: "CanadianHamTV",
    destination: "generic/platform=tvOS",
    artifact: :ipa,
    app_platform: "appletvos"
  },
  xros: {
    scheme: "CanadianHamVision",
    destination: "generic/platform=visionOS",
    artifact: :ipa,
    app_platform: "xros"
  }
}.freeze

desc "Create or fetch the Apple Development, Apple Distribution and Mac Installer Distribution certificates into the build keychain (API key, non-interactive)."
lane :signing_certificates do
  # get_certificates writes private keys (*.p12) to CERT_OUTPUT_DIR with the
  # process umask; keep every invocation owner-only.
  File.umask(0o077)
  FileUtils.mkdir_p(CERT_OUTPUT_DIR, mode: 0o700)
  app_store_connect_api_key(**API_KEY)
  unlock_build_keychain
  common = {
    generate_apple_certs: true,
    keychain_path: BUILD_KEYCHAIN_PATH,
    keychain_password: build_keychain_password,
    output_path: CERT_OUTPUT_DIR
  }
  get_certificates(**common, development: true, platform: "ios")
  get_certificates(**common, development: false, platform: "ios")
  get_certificates(**common, type: "mac_installer_distribution", platform: "macos")
  FileUtils.chmod(0o700, CERT_OUTPUT_DIR)
  FileUtils.chmod(0o600, Dir[File.join(CERT_OUTPUT_DIR, "*")])
end

platform :ios do
  before_all do
    app_store_connect_api_key(**API_KEY)
  end

  desc "Register the universal Developer Portal bundle ID using the App Store Connect API key. Idempotent."
  lane :register_bundle_ids do
    register_universal_bundle_id
  end

  desc "Create the App Store Connect app record for iOS, macOS and tvOS (add visionOS in App Store Connect). Requires Apple ID + 2FA; do not run non-interactively."
  lane :create_app_record do
    create_canadian_ham_app_record
  end

  desc "Print the App Store Connect app record and version states."
  lane :asc_status do
    print_asc_status
  end

  desc "Archive/export the iOS Release build with xbuild and upload it to internal TestFlight."
  lane :beta do |options|
    upload_beta(:ios, options)
  end
end

platform :mac do
  before_all do
    app_store_connect_api_key(**API_KEY)
  end

  desc "Archive/export the macOS Release build with xbuild and upload it to internal TestFlight."
  lane :beta do |options|
    upload_beta(:mac, options)
  end
end

platform :appletvos do
  before_all do
    app_store_connect_api_key(**API_KEY)
  end

  desc "Archive/export the tvOS Release build with xbuild and upload it to internal TestFlight."
  lane :beta do |options|
    upload_beta(:appletvos, options)
  end
end

platform :xros do
  before_all do
    app_store_connect_api_key(**API_KEY)
  end

  desc "Archive/export the visionOS Release build with xbuild and upload it to internal TestFlight."
  lane :beta do |options|
    upload_beta(:xros, options)
  end
end

def register_universal_bundle_id
  require "spaceship"

  Spaceship::ConnectAPI.token = connect_api_token
  existing = Spaceship::ConnectAPI::BundleId.find(PRIMARY_BUNDLE_ID)
  if existing
    UI.success("Bundle ID already exists on Developer Portal: #{PRIMARY_BUNDLE_ID}")
  else
    UI.message("Registering bundle ID on Developer Portal: #{PRIMARY_BUNDLE_ID}")
    Spaceship::ConnectAPI::BundleId.create(
      name: APP_NAME,
      identifier: PRIMARY_BUNDLE_ID,
      platform: "UNIVERSAL"
    )
    UI.success("Created bundle ID: #{PRIMARY_BUNDLE_ID}")
  end

  if REQUIRED_CAPABILITIES.empty?
    UI.success("No default-build App ID capabilities are required for #{PRIMARY_BUNDLE_ID}.")
    UI.important("DebugCloudKit is intentionally excluded from Release uploads; if enabled later, configure iCloud.org.davidjensenius.CanadianHam plus iCloud/Push capabilities separately.")
  end
end

def create_canadian_ham_app_record
  produce(
    app_identifier: PRIMARY_BUNDLE_ID,
    app_name: APP_NAME,
    sku: APP_SKU,
    language: PRIMARY_LANGUAGE,
    app_version: marketing_version,
    # produce only supports ios, osx and tvos; add visionOS in App Store Connect
    # (App Information → Add Platform) after the record exists.
    platforms: %w[ios osx tvos],
    skip_devcenter: true
  )
end

# project.yml is the single source of truth for the marketing version.
def marketing_version
  project_yml = File.read(File.join(REPO_ROOT, "apps/apple/project.yml"))
  version = project_yml[/^\s*MARKETING_VERSION:\s*"?([0-9][0-9.]*)"?\s*$/, 1]
  UI.user_error!("MARKETING_VERSION not found in apps/apple/project.yml") unless version
  version
end

def print_asc_status
  require "spaceship"
  Spaceship::ConnectAPI.token = connect_api_token

  app = Spaceship::ConnectAPI::App.find(PRIMARY_BUNDLE_ID)
  if app.nil?
    UI.important("APP NOT FOUND on App Store Connect for #{PRIMARY_BUNDLE_ID}")
    return
  end

  UI.success("APP FOUND: #{app.name} (id=#{app.id}) sku=#{app.sku}")
  app.get_app_store_versions.each do |version|
    UI.message("  version #{version.version_string} platform=#{version.platform} state=#{version.app_store_state}")
    begin
      build = version.get_build
      UI.message("    build: #{build ? build.version : 'NONE ATTACHED'}")
    rescue StandardError => e
      UI.error("    build error: #{e.class}: #{e.message}")
    end
  end
end

# Pass artifact_path:<exported .ipa/.pkg> to upload an existing export
# without re-archiving (for example, after an upload-only failure).
# Pass export_only:true to inspect a signed export without uploading it.
def upload_beta(platform_key, options = {})
  result =
    if options[:artifact_path]
      config = BETA_PLATFORMS.fetch(platform_key)
      path = File.expand_path(options[:artifact_path])
      UI.user_error!("No artifact at #{path}") unless File.file?(path)
      { artifact: config[:artifact], artifact_path: path, app_platform: config[:app_platform] }
    else
      archive_and_export(platform_key, official_reference_sheet: true)
    end
  if options[:export_only].to_s == "true"
    UI.success("Export only; skipping TestFlight upload: #{result[:artifact_path]}")
    return result
  end

  upload_args = {
    app_identifier: PRIMARY_BUNDLE_ID,
    app_platform: result[:app_platform],
    skip_waiting_for_build_processing: true
  }
  upload_args[result[:artifact]] = result[:artifact_path]
  upload_to_testflight(**upload_args)
end

def build_keychain_password
  unless File.file?(BUILD_KEYCHAIN_PASSWORD_FILE)
    UI.user_error!("Missing #{BUILD_KEYCHAIN_PASSWORD_FILE}; see the signing keychain setup in docs/release/testflight.md")
  end
  File.read(BUILD_KEYCHAIN_PASSWORD_FILE).strip
end

def unlock_build_keychain
  UI.user_error!("Missing #{BUILD_KEYCHAIN_PATH}; see docs/release/testflight.md") unless File.exist?(BUILD_KEYCHAIN_PATH)
  unlock_keychain(path: BUILD_KEYCHAIN_PATH, password: build_keychain_password, add_to_search_list: true, set_default: false)
end

def archive_and_export(platform_key, official_reference_sheet: false)
  unlock_build_keychain
  config = BETA_PLATFORMS.fetch(platform_key)
  build_number = Time.now.strftime("%Y%m%d%H%M")
  archive_path = File.join(ARCHIVE_ROOT, platform_key.to_s, "#{config[:scheme]}-#{build_number}.xcarchive")
  export_path = File.join(BUILD_ROOT, platform_key.to_s, build_number)
  FileUtils.rm_rf(export_path)
  FileUtils.mkdir_p(File.dirname(archive_path))
  FileUtils.mkdir_p(export_path)

  archive_args = [
    "-project", PROJECT_PATH,
    "-scheme", config[:scheme],
    "-configuration", "Release",
    "-destination", config[:destination],
    "-archivePath", archive_path,
    *XBUILD_AUTH_ARGS,
    "archive",
    "CURRENT_PROJECT_VERSION=#{build_number}",
    "CODE_SIGNING_ALLOWED=YES",
    *(config[:build_settings] || [])
  ]
  # Owner decision 2A: upload_beta explicitly opts in; shared archives default off.
  archive_args << "OTHER_SWIFT_FLAGS=$(inherited) -DOFFICIAL_REFERENCE_SHEET" if official_reference_sheet
  run_xbuild(archive_args)

  export_args = [
    "-exportArchive",
    "-archivePath", archive_path,
    "-exportPath", export_path,
    "-exportOptionsPlist", EXPORT_OPTIONS_PLIST,
    *XBUILD_AUTH_ARGS
  ]
  run_xbuild(export_args)

  pattern = config[:artifact] == :pkg ? "*.pkg" : "*.ipa"
  artifact_path = Dir[File.join(export_path, pattern)].first
  UI.user_error!("xbuild export did not produce #{pattern} in #{export_path}") unless artifact_path

  UI.success("Archived #{config[:scheme]} build #{build_number} to #{archive_path}")
  UI.success("Exported #{artifact_path}")
  {
    artifact: config[:artifact],
    artifact_path: artifact_path,
    app_platform: config[:app_platform]
  }
end

def run_xbuild(args)
  command = (["DEVELOPER_DIR=#{Shellwords.escape(DEVELOPER_DIR)}", "xbuild"] + args.map { |arg| Shellwords.escape(arg) }).join(" ")
  UI.command(command)
  sh(command)
end

def connect_api_token
  require "spaceship"
  Spaceship::ConnectAPI::Token.create(
    key_id: API_KEY[:key_id],
    issuer_id: API_KEY[:issuer_id],
    filepath: API_KEY[:key_filepath]
  )
end
