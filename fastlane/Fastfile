require "fileutils"
require "shellwords"

opt_out_usage

default_platform(:ios)

API_KEY = {
  key_id: "XP65R4N5A2",
  issuer_id: "69a6de7e-a5f5-47e3-e053-5b8c7c11a4d1",
  key_filepath: File.expand_path("~/.appstoreconnect/AuthKey_XP65R4N5A2.p8")
}.freeze

TEAM_ID = "9JALHNGRBQ"
APP_NAME = "Canadian Ham"
APP_SKU = "canadian-ham"
PRIMARY_BUNDLE_ID = "org.davidjensenius.CanadianHam"
PRIMARY_LANGUAGE = "en-CA"
REPO_ROOT = File.expand_path("..", __dir__)
PROJECT_PATH = File.join(REPO_ROOT, "apps/apple/CanadianHam.xcodeproj")
EXPORT_OPTIONS_PLIST = File.join(REPO_ROOT, "fastlane/ExportOptions.plist")
DEVELOPER_DIR = "/Applications/Xcode.app/Contents/Developer"
ARCHIVE_ROOT = File.join(REPO_ROOT, "fastlane/archives")
BUILD_ROOT = File.join(REPO_ROOT, "fastlane/builds")

# Default Release uploads carry no capabilities beyond the app's default
# entitlements. The off-by-default DebugCloudKit gate is not uploaded by these
# lanes. If that gated build is ever distributed later, the Developer Portal App
# ID will also need iCloud (CloudKit), Push Notifications and the
# iCloud.org.davidjensenius.CanadianHam container configured explicitly.
REQUIRED_CAPABILITIES = {}.freeze

XBUILD_AUTH_ARGS = [
  "-allowProvisioningUpdates",
  "-authenticationKeyPath", API_KEY[:key_filepath],
  "-authenticationKeyID", API_KEY[:key_id],
  "-authenticationKeyIssuerID", API_KEY[:issuer_id]
].freeze

BETA_PLATFORMS = {
  ios: {
    scheme: "CanadianHam",
    destination: "generic/platform=iOS",
    artifact: :ipa,
    app_platform: "ios"
  },
  mac: {
    scheme: "CanadianHam",
    destination: "generic/platform=macOS",
    artifact: :pkg,
    app_platform: "osx",
    build_settings: %w[SDKROOT=macosx SUPPORTED_PLATFORMS=macosx]
  },
  appletvos: {
    scheme: "CanadianHamTV",
    destination: "generic/platform=tvOS",
    artifact: :ipa,
    app_platform: "appletvos"
  },
  xros: {
    scheme: "CanadianHamVision",
    destination: "generic/platform=visionOS",
    artifact: :ipa,
    app_platform: "xros"
  }
}.freeze

platform :ios do
  before_all do
    app_store_connect_api_key(**API_KEY)
  end

  desc "Register the universal Developer Portal bundle ID using the App Store Connect API key. Idempotent."
  lane :register_bundle_ids do
    register_universal_bundle_id
  end

  desc "Create the App Store Connect app record for iOS, macOS, tvOS and visionOS. Requires Apple ID + 2FA; do not run non-interactively."
  lane :create_app_record do
    create_canadian_ham_app_record
  end

  desc "Print the App Store Connect app record and version states."
  lane :asc_status do
    print_asc_status
  end

  desc "Archive/export the iOS Release build with xbuild and upload it to internal TestFlight."
  lane :beta do
    upload_beta(:ios)
  end
end

platform :mac do
  before_all do
    app_store_connect_api_key(**API_KEY)
  end

  desc "Archive/export the macOS Release build with xbuild and upload it to internal TestFlight."
  lane :beta do
    upload_beta(:mac)
  end
end

platform :appletvos do
  before_all do
    app_store_connect_api_key(**API_KEY)
  end

  desc "Archive/export the tvOS Release build with xbuild and upload it to internal TestFlight."
  lane :beta do
    upload_beta(:appletvos)
  end
end

platform :xros do
  before_all do
    app_store_connect_api_key(**API_KEY)
  end

  desc "Archive/export the visionOS Release build with xbuild and upload it to internal TestFlight."
  lane :beta do
    upload_beta(:xros)
  end
end

def register_universal_bundle_id
  require "spaceship"

  Spaceship::ConnectAPI.token = connect_api_token
  existing = Spaceship::ConnectAPI::BundleId.find(PRIMARY_BUNDLE_ID)
  if existing
    UI.success("Bundle ID already exists on Developer Portal: #{PRIMARY_BUNDLE_ID}")
  else
    UI.message("Registering bundle ID on Developer Portal: #{PRIMARY_BUNDLE_ID}")
    Spaceship::ConnectAPI::BundleId.create(
      name: APP_NAME,
      identifier: PRIMARY_BUNDLE_ID,
      platform: "UNIVERSAL"
    )
    UI.success("Created bundle ID: #{PRIMARY_BUNDLE_ID}")
  end

  if REQUIRED_CAPABILITIES.empty?
    UI.success("No default-build App ID capabilities are required for #{PRIMARY_BUNDLE_ID}.")
    UI.important("DebugCloudKit is intentionally excluded from Release uploads; if enabled later, configure iCloud.org.davidjensenius.CanadianHam plus iCloud/Push capabilities separately.")
  end
end

def create_canadian_ham_app_record
  produce(
    app_identifier: PRIMARY_BUNDLE_ID,
    app_name: APP_NAME,
    sku: APP_SKU,
    language: PRIMARY_LANGUAGE,
    # produce only supports ios, osx and tvos; add visionOS in App Store Connect
    # (App Information → Add Platform) after the record exists.
    platforms: %w[ios osx tvos],
    skip_devcenter: true
  )
end

def print_asc_status
  require "spaceship"
  Spaceship::ConnectAPI.token = connect_api_token

  app = Spaceship::ConnectAPI::App.find(PRIMARY_BUNDLE_ID)
  if app.nil?
    UI.important("APP NOT FOUND on App Store Connect for #{PRIMARY_BUNDLE_ID}")
    return
  end

  UI.success("APP FOUND: #{app.name} (id=#{app.id}) sku=#{app.sku}")
  app.get_app_store_versions.each do |version|
    UI.message("  version #{version.version_string} platform=#{version.platform} state=#{version.app_store_state}")
    begin
      build = version.get_build
      UI.message("    build: #{build ? build.version : 'NONE ATTACHED'}")
    rescue StandardError => e
      UI.error("    build error: #{e.class}: #{e.message}")
    end
  end
end

def upload_beta(platform_key)
  result = archive_and_export(platform_key)
  upload_args = {
    app_identifier: PRIMARY_BUNDLE_ID,
    app_platform: result[:app_platform],
    skip_waiting_for_build_processing: true
  }
  upload_args[result[:artifact]] = result[:artifact_path]
  upload_to_testflight(**upload_args)
end

def archive_and_export(platform_key)
  config = BETA_PLATFORMS.fetch(platform_key)
  build_number = Time.now.strftime("%Y%m%d%H%M")
  archive_path = File.join(ARCHIVE_ROOT, platform_key.to_s, "#{config[:scheme]}-#{build_number}.xcarchive")
  export_path = File.join(BUILD_ROOT, platform_key.to_s, build_number)
  FileUtils.rm_rf(export_path)
  FileUtils.mkdir_p(File.dirname(archive_path))
  FileUtils.mkdir_p(export_path)

  archive_args = [
    "-project", PROJECT_PATH,
    "-scheme", config[:scheme],
    "-configuration", "Release",
    "-destination", config[:destination],
    "-archivePath", archive_path,
    *XBUILD_AUTH_ARGS,
    "archive",
    "MARKETING_VERSION=1.0.0",
    "CURRENT_PROJECT_VERSION=#{build_number}",
    "CODE_SIGNING_ALLOWED=YES",
    *(config[:build_settings] || [])
  ]
  run_xbuild(archive_args)

  export_args = [
    "-exportArchive",
    "-archivePath", archive_path,
    "-exportPath", export_path,
    "-exportOptionsPlist", EXPORT_OPTIONS_PLIST,
    *XBUILD_AUTH_ARGS
  ]
  run_xbuild(export_args)

  pattern = config[:artifact] == :pkg ? "*.pkg" : "*.ipa"
  artifact_path = Dir[File.join(export_path, pattern)].first
  UI.user_error!("xbuild export did not produce #{pattern} in #{export_path}") unless artifact_path

  UI.success("Archived #{config[:scheme]} build #{build_number} to #{archive_path}")
  UI.success("Exported #{artifact_path}")
  {
    artifact: config[:artifact],
    artifact_path: artifact_path,
    app_platform: config[:app_platform]
  }
end

def run_xbuild(args)
  command = (["DEVELOPER_DIR=#{Shellwords.escape(DEVELOPER_DIR)}", "xbuild"] + args.map { |arg| Shellwords.escape(arg) }).join(" ")
  UI.command(command)
  sh(command)
end

def connect_api_token
  require "spaceship"
  Spaceship::ConnectAPI::Token.create(
    key_id: API_KEY[:key_id],
    issuer_id: API_KEY[:issuer_id],
    filepath: API_KEY[:key_filepath]
  )
end
