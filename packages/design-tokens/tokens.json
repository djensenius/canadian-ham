{
  "$schema": "./tokens.schema.json",
  "meta": {
    "name": "Canadian Ham ink-paper design tokens",
    "version": "1.0.0",
    "description": "Single source of truth for colours, type scale, spacing, radii, and motion. Accent is vermilion seal red to match the sumi-e icon family while avoiding status-colour ambiguity."
  },
  "themes": {
    "light": {
      "colors": {
        "paper": "#F6EEDC",
        "paperElevated": "#FFF8EA",
        "paperInset": "#EFE3CB",
        "ink": "#1F1A14",
        "inkMuted": "#5E5347",
        "border": "#8C7656",
        "accent": "#A53A2A",
        "accentStrong": "#8F2E1D",
        "focus": "#8F2E1D",
        "correctText": "#284C2B",
        "correctBg": "#E8F1DD",
        "correctBorder": "#5D8A48",
        "incorrectText": "#7F241B",
        "incorrectBg": "#F4E2DE",
        "incorrectBorder": "#B64A3B",
        "warningText": "#6B4B00",
        "warningBg": "#F8E7B4",
        "warningBorder": "#9B6A00"
      }
    },
    "dark": {
      "colors": {
        "paper": "#201B16",
        "paperElevated": "#2A241D",
        "paperInset": "#181410",
        "ink": "#F3E8D2",
        "inkMuted": "#CBBDA4",
        "border": "#8A7759",
        "accent": "#FF8A70",
        "accentStrong": "#FFB09C",
        "focus": "#FFB36B",
        "correctText": "#DDF2D7",
        "correctBg": "#1F3323",
        "correctBorder": "#76B16B",
        "incorrectText": "#FFD7CF",
        "incorrectBg": "#3A211E",
        "incorrectBorder": "#E27966",
        "warningText": "#FFE3A3",
        "warningBg": "#342B16",
        "warningBorder": "#D3A13D"
      }
    }
  },
  "typography": {
    "families": {
      "display": "ui-serif, 'New York', 'Iowan Old Style', Georgia, serif",
      "body": "system-ui, -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', sans-serif",
      "mono": "ui-monospace, 'SF Mono', Menlo, Consolas, monospace"
    },
    "scale": {
      "caption": { "rem": 0.8125, "lineHeight": 1.35 },
      "body": { "rem": 1, "lineHeight": 1.55 },
      "bodyLarge": { "rem": 1.125, "lineHeight": 1.5 },
      "title": { "rem": 1.5, "lineHeight": 1.25 },
      "headline": { "rem": 2, "lineHeight": 1.15 },
      "display": { "rem": 2.75, "lineHeight": 1.05 }
    }
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "xxl": 32,
    "xxxl": 48,
    "tvSafe": 96,
    "visionDepth": 28
  },
  "radii": {
    "xs": 6,
    "sm": 10,
    "md": 16,
    "lg": 24,
    "pill": 999
  },
  "motion": {
    "durations": {
      "instant": 0,
      "fast": 120,
      "normal": 180,
      "slow": 280
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "emphasized": "cubic-bezier(0.2, 0, 0, 1.2)"
    }
  },
  "contrastPairs": [
    { "id": "light-body", "theme": "light", "foreground": "ink", "background": "paper", "kind": "body" },
    { "id": "light-muted", "theme": "light", "foreground": "inkMuted", "background": "paper", "kind": "body" },
    { "id": "light-accent-link", "theme": "light", "foreground": "accent", "background": "paper", "kind": "body" },
    { "id": "light-border", "theme": "light", "foreground": "border", "background": "paper", "kind": "ui" },
    { "id": "light-focus", "theme": "light", "foreground": "focus", "background": "paper", "kind": "ui" },
    { "id": "light-card-body", "theme": "light", "foreground": "ink", "background": "paperElevated", "kind": "body" },
    { "id": "light-card-border", "theme": "light", "foreground": "border", "background": "paperElevated", "kind": "ui" },
    { "id": "light-correct-text", "theme": "light", "foreground": "correctText", "background": "correctBg", "kind": "body" },
    { "id": "light-correct-border", "theme": "light", "foreground": "correctBorder", "background": "correctBg", "kind": "ui" },
    { "id": "light-incorrect-text", "theme": "light", "foreground": "incorrectText", "background": "incorrectBg", "kind": "body" },
    { "id": "light-incorrect-border", "theme": "light", "foreground": "incorrectBorder", "background": "incorrectBg", "kind": "ui" },
    { "id": "light-warning-text", "theme": "light", "foreground": "warningText", "background": "warningBg", "kind": "body" },
    { "id": "light-warning-border", "theme": "light", "foreground": "warningBorder", "background": "warningBg", "kind": "ui" },
    { "id": "dark-body", "theme": "dark", "foreground": "ink", "background": "paper", "kind": "body" },
    { "id": "dark-muted", "theme": "dark", "foreground": "inkMuted", "background": "paper", "kind": "body" },
    { "id": "dark-accent-link", "theme": "dark", "foreground": "accent", "background": "paper", "kind": "body" },
    { "id": "dark-border", "theme": "dark", "foreground": "border", "background": "paper", "kind": "ui" },
    { "id": "dark-focus", "theme": "dark", "foreground": "focus", "background": "paper", "kind": "ui" },
    { "id": "dark-card-body", "theme": "dark", "foreground": "ink", "background": "paperElevated", "kind": "body" },
    { "id": "dark-card-border", "theme": "dark", "foreground": "border", "background": "paperElevated", "kind": "ui" },
    { "id": "dark-correct-text", "theme": "dark", "foreground": "correctText", "background": "correctBg", "kind": "body" },
    { "id": "dark-correct-border", "theme": "dark", "foreground": "correctBorder", "background": "correctBg", "kind": "ui" },
    { "id": "dark-incorrect-text", "theme": "dark", "foreground": "incorrectText", "background": "incorrectBg", "kind": "body" },
    { "id": "dark-incorrect-border", "theme": "dark", "foreground": "incorrectBorder", "background": "incorrectBg", "kind": "ui" },
    { "id": "dark-warning-text", "theme": "dark", "foreground": "warningText", "background": "warningBg", "kind": "body" },
    { "id": "dark-warning-border", "theme": "dark", "foreground": "warningBorder", "background": "warningBg", "kind": "ui" }
  ]
}
