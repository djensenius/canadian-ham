{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "generated-bank-manifest.schema.json",
  "title": "Generated ISED bank manifest",
  "oneOf": [
    { "$ref": "#/$defs/basicManifest" },
    { "$ref": "#/$defs/advancedManifest" }
  ],
  "$defs": {
    "baseManifest": {
      "type": "object",
      "required": ["bankId", "certificate", "effectiveDate", "source", "importer", "counts"],
      "properties": {
        "bankId": { "$ref": "common.schema.json#/$defs/bankId" },
        "certificate": { "enum": ["canadian-amateur-basic", "canadian-amateur-advanced"] },
        "effectiveDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "source": {
          "type": "object",
          "required": ["path", "sha256", "url", "encoding", "lineEndings"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "url": { "type": "string", "minLength": 1 },
            "encoding": { "enum": ["UTF-8", "Windows-1252"] },
            "lineEndings": { "const": "CRLF" }
          },
          "additionalProperties": false
        },
        "importer": {
          "type": "object",
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "const": "1" }
          },
          "additionalProperties": false
        },
        "counts": {
          "type": "object",
          "required": ["questions", "categories", "subsections"],
          "properties": {
            "questions": { "type": "integer", "minimum": 0 },
            "categories": { "type": "integer", "minimum": 0 },
            "subsections": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "basicManifest": {
      "allOf": [
        { "$ref": "#/$defs/baseManifest" },
        {
          "type": "object",
          "properties": {
            "bankId": { "const": "basic-2025-07-15" },
            "certificate": { "const": "canadian-amateur-basic" },
            "effectiveDate": { "const": "2025-07-15" },
            "source": {
              "type": "object",
              "properties": {
                "path": { "const": "content/sources/ised/basic-2025-07-15/questions/amat_basic_quest_delim.txt" },
                "sha256": { "const": "34c7cd7967addfde648c566d0ecf25bf3d1e071c603b5101cfecc7bd0cbc284f" },
                "url": { "const": "https://apc-cap.ic.gc.ca/datafiles/amat_basic_quest.zip#amat_basic_quest_delim.txt" },
                "encoding": { "const": "UTF-8" }
              }
            },
            "importer": { "type": "object", "properties": { "name": { "const": "packages/content-tools/src/import-basic.ts" } } },
            "counts": { "type": "object", "properties": { "questions": { "const": 984 }, "categories": { "const": 8 }, "subsections": { "const": 100 } } }
          }
        }
      ]
    },
    "advancedManifest": {
      "allOf": [
        { "$ref": "#/$defs/baseManifest" },
        {
          "type": "object",
          "properties": {
            "bankId": { "const": "advanced-2025-02-04" },
            "certificate": { "const": "canadian-amateur-advanced" },
            "effectiveDate": { "const": "2025-02-04" },
            "source": {
              "type": "object",
              "properties": {
                "path": { "const": "content/sources/ised/advanced-2025-02-04/questions/amat_adv_quest_delim.txt" },
                "sha256": { "const": "a8e7760fb6828ad3b8af3d53d16e1b8f34acbf3c961e11eeffadd89ef0789fd7" },
                "url": { "const": "https://apc-cap.ic.gc.ca/datafiles/amat_adv_quest.zip#amat_adv_quest_delim.txt" },
                "encoding": { "const": "UTF-8" }
              }
            },
            "importer": { "type": "object", "properties": { "name": { "const": "packages/content-tools/src/import-advanced.ts" } } },
            "counts": { "type": "object", "properties": { "questions": { "const": 549 }, "categories": { "const": 7 }, "subsections": { "const": 50 } } }
          }
        }
      ]
    }
  }
}
