{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "generated-bank-manifest.schema.json",
  "title": "Generated ISED Basic bank manifest",
  "type": "object",
  "required": ["bankId", "certificate", "effectiveDate", "source", "importer", "counts"],
  "properties": {
    "bankId": { "$ref": "common.schema.json#/$defs/bankId" },
    "certificate": { "const": "canadian-amateur-basic" },
    "effectiveDate": { "const": "2025-07-15" },
    "source": {
      "type": "object",
      "required": ["path", "sha256", "url", "encoding", "lineEndings"],
      "properties": {
        "path": { "const": "content/sources/ised/basic-2025-07-15/questions/amat_basic_quest_delim.txt" },
        "sha256": { "const": "34c7cd7967addfde648c566d0ecf25bf3d1e071c603b5101cfecc7bd0cbc284f" },
        "url": { "const": "https://apc-cap.ic.gc.ca/datafiles/amat_basic_quest.zip#amat_basic_quest_delim.txt" },
        "encoding": { "const": "UTF-8" },
        "lineEndings": { "const": "CRLF" }
      },
      "additionalProperties": false
    },
    "importer": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "packages/content-tools/src/import-basic.ts" },
        "version": { "const": "1" }
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "required": ["questions", "categories", "subsections"],
      "properties": {
        "questions": { "const": 984 },
        "categories": { "const": 8 },
        "subsections": { "const": 100 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
