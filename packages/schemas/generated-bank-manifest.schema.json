{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "generated-bank-manifest.schema.json",
  "title": "Generated ISED Basic bank manifest",
  "type": "object",
  "required": ["bankId", "certificate", "effectiveDate", "source", "importer", "counts"],
  "properties": {
    "bankId": { "$ref": "common.schema.json#/$defs/bankId" },
    "certificate": { "const": "canadian-amateur-basic" },
    "effectiveDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source": {
      "type": "object",
      "required": ["path", "sha256", "url", "encoding", "lineEndings"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "url": { "type": "string", "minLength": 1 },
        "encoding": { "const": "UTF-8" },
        "lineEndings": { "enum": ["CRLF", "LF"] }
      },
      "additionalProperties": false
    },
    "importer": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "required": ["questions", "categories", "subsections"],
      "properties": {
        "questions": { "type": "integer", "minimum": 0 },
        "categories": { "type": "integer", "minimum": 0 },
        "subsections": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
