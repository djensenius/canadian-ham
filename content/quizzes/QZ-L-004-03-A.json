            "fr": null
          },
          "isCorrect": false
        },
        {
          "text": {
            "en": "820 ohms",
            "fr": null
          },
          "isCorrect": true
        },
        {
          "text": {
            "en": "8 200 ohms",
            "fr": null
          },
          "isCorrect": false
        },
        {
          "text": {
            "en": "92 ohms",
            "fr": null
          },
          "isCorrect": false
        }
      ],
      "explanation": {
        "en": "Grey and red form 82, and brown is the x 10 multiplier, so the nominal value is 82 x 10 = 820 ohms.",
