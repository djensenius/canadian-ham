      },
      "choices": [
        {
          "text": {
            "en": "A 1 kilohm ±1% part only",
            "fr": null
          },
          "isCorrect": false
        },
        {
          "text": {
            "en": "Both a 1 kilohm ±1% part and a 1 kilohm ±10% part",
            "fr": null
          },
          "isCorrect": false
        },
        {
          "text": {
            "en": "A 1 kilohm ±10% part only",
            "fr": null
          },
          "isCorrect": true
        },
        {
          "text": {
            "en": "Neither part, because 1 080 ohms is outside both ranges",
            "fr": null
