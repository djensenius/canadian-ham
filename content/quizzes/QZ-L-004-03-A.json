    {
      "id": "QZ-L-004-03-A-C1",
      "prompt": {
        "en": "A resistor reads grey, red, brown, gold. What nominal value do the first three bands give?",
        "fr": null
      },
      "choices": [
        {
          "text": {
            "en": "82 ohms",
            "fr": null
          },
          "isCorrect": false
        },
        {
          "text": {
            "en": "820 ohms",
            "fr": null
          },
          "isCorrect": true
        },
        {
          "text": {
            "en": "8 200 ohms",
            "fr": null
          },
          "isCorrect": false
        },
        {
          "text": {
            "en": "92 ohms",
            "fr": null
          },
          "isCorrect": false
        }
      ],
      "explanation": {
        "en": "Grey and red form 82, and brown is the x 10 multiplier, so the nominal value is 82 x 10 = 820 ohms.",
        "fr": null
      }
    },
    {
      "id": "QZ-L-004-03-A-C2",
      "prompt": {
        "en": "What does a smaller resistor tolerance percentage mean?",
        "fr": null
      },
      "choices": [
        {
          "text": {
            "en": "The resistor has no ohmic value",
            "fr": null
          },
          "isCorrect": false
        },
        {
          "text": {
            "en": "The resistor must be physically larger",
            "fr": null
          },
          "isCorrect": false
        },
        {
          "text": {
            "en": "The allowed spread around the nominal value is narrower",
            "fr": null
          },
          "isCorrect": true
        },
        {
          "text": {
            "en": "The multiplier band is ignored",
            "fr": null
          },
          "isCorrect": false
        }
      ],
      "explanation": {
        "en": "Higher precision means less permitted variation from the nominal resistance.",
        "fr": null
      }
    },
    {
      "id": "QZ-L-004-03-A-C3",
      "prompt": {
        "en": "Two resistors have the same first two value bands, but one has a multiplier that is one step larger. What changes?",
        "fr": null
      },
      "choices": [
        {
          "text": {
            "en": "Only the tolerance can change",
            "fr": null
          },
          "isCorrect": false
        },
        {
          "text": {
            "en": "The nominal resistance changes by a factor of ten",
            "fr": null
          },
          "isCorrect": true
        },
        {
          "text": {
            "en": "The component stops being a resistor",
            "fr": null
          },
          "isCorrect": false
        },
        {
          "text": {
            "en": "The colour code no longer uses digits",
            "fr": null
          },
          "isCorrect": false
        }
      ],
      "explanation": {
