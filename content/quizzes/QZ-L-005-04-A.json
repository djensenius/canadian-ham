      "id": "QZ-L-005-04-A-C1",
      "prompt": { "en": "A transmitter power is reduced from 120 W to 30 W. What is the approximate dB change?", "fr": null },
      "choices": [
        { "text": { "en": "+6 dB", "fr": null }, "isCorrect": false },
        { "text": { "en": "-3 dB", "fr": null }, "isCorrect": false },
        { "text": { "en": "+10 dB", "fr": null }, "isCorrect": false },
        { "text": { "en": "-6 dB", "fr": null }, "isCorrect": true }
      ],
      "explanation": { "en": "120 W to 30 W divides power by 4, which is a 6 dB decrease.", "fr": null }
    },
    {
