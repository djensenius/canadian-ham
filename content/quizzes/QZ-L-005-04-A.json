        { "text": { "en": "S9 plus 26 dB", "fr": null }, "isCorrect": false },
        { "text": { "en": "S9 plus 6 dB", "fr": null }, "isCorrect": true },
        { "text": { "en": "S6", "fr": null }, "isCorrect": false },
        { "text": { "en": "S9 plus 10 dB", "fr": null }, "isCorrect": false }
