{
  "name": "canadian-ham",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "test": "pnpm --filter @canadian-ham/content-tools test && pnpm --filter @canadian-ham/web test",
    "import:check": "pnpm --filter @canadian-ham/content-tools import:basic:check",
    "diff:banks": "pnpm --filter @canadian-ham/content-tools diff:banks",
    "check:links": "node packages/content-tools/src/check-links.ts",
    "check:apple-network": "bash scripts/check-apple-no-network.sh",
    "test:apple-network": "bash scripts/test-check-apple-no-network.sh",
    "typecheck": "pnpm -r typecheck",
    "build:web": "pnpm --filter @canadian-ham/web build",
    "check:apple-l10n": "bash scripts/check-apple-localizations.sh"
  }
}
