{
  "name": "canadian-ham",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.8.2",
  "scripts": {
    "test": "pnpm test:official-reference-sheet && pnpm test:release-permission && pnpm --filter @canadian-ham/content-tools test && pnpm --filter @canadian-ham/morse-engine test && pnpm --filter @canadian-ham/calculator-engine test && pnpm --filter @canadian-ham/web test",
    "test:official-reference-sheet": "node scripts/check-official-reference-sheet-gate.mjs",
    "test:release-permission": "node scripts/check-release-permission.mjs --self-test",
    "import:check": "pnpm --filter @canadian-ham/content-tools import:basic:check && pnpm --filter @canadian-ham/content-tools import:advanced:check && pnpm --filter @canadian-ham/content-tools check:reference-sheet",
    "diff:banks": "pnpm --filter @canadian-ham/content-tools diff:banks",
    "check:links": "node packages/content-tools/src/check-links.ts",
    "check:figures": "node scripts/check-figures.mjs --self-test && node scripts/check-figures.mjs",
    "check:figures:fix": "node scripts/check-figures.mjs --fix",
    "check:hints": "pnpm --filter @canadian-ham/content-tools check:hints",
    "check:hints:self-test": "pnpm --filter @canadian-ham/content-tools check:hints:self-test",
    "check:schemas": "pnpm --filter @canadian-ham/schemas test",
    "check:apple-network": "bash scripts/check-apple-no-network.sh",
    "check:apple-icloud-gate": "node scripts/check-apple-icloud-gate.mjs",
    "test:apple-icloud-gate": "node scripts/test-check-apple-icloud-gate.mjs",
    "test:apple-network": "bash scripts/test-check-apple-no-network.sh",
    "typecheck": "pnpm -r typecheck",
    "build:web": "pnpm --filter @canadian-ham/web build",
    "check:apple-l10n": "bash scripts/check-apple-localizations.sh"
  }
}
