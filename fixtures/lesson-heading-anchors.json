{
  "slugCases": [
    {
      "name": "inline code and raw html are ignored",
      "headingText": "A  `B` <em>C</em>!",
      "expectedSlug": "a--b-c"
    },
    {
      "name": "accents are preserved and punctuation is removed",
      "headingText": "Réglages d’émetteur : VFO",
      "expectedSlug": "réglages-démetteur--vfo"
    },
    {
      "name": "authority table anchor",
      "headingText": "Reference facts: Authority and source roles",
      "expectedSlug": "reference-facts-authority-and-source-roles"
    },
    {
      "name": "inline links and emphasis are stripped before slugging",
      "headingText": "Review [linked *power*](https://example.invalid) and **gain**",
      "expectedSlug": "review-linked-power-and-gain"
    }
  ],
  "anchorCases": [
    {
      "name": "depth-1 title is not linkable",
      "title": "Fixture Lesson",
