      "expectedAnchors": [
        "shared-setup"
      ],
      "rejectedAnchors": [
        "fixture-lesson"
      ]
    },
    {
      "name": "duplicate headings receive numeric suffixes",
      "title": null,
      "markdown": "## Shared setup\n\nText.\n\n## Shared setup\n",
      "expectedAnchors": [
        "shared-setup",
        "shared-setup-1"
      ],
      "rejectedAnchors": []
    },
    {
      "name": "inline code html and accents follow shared slug rules",
      "title": null,
      "markdown": "## Réglages `VFO` <em>émetteur</em>!\n",
      "expectedAnchors": [
        "réglages-vfo-émetteur"
      ],
      "rejectedAnchors": []
    },
    {
      "name": "illustration brief is not linkable",
      "title": null,
      "markdown": "## Illustration brief\n\nAlt text: Fixture.\n\nDescription: Draw a fixture.\n\n## Summary\n",
      "expectedAnchors": [
        "summary"
      ],
      "rejectedAnchors": [
        "illustration-brief"
      ]
    },
    {
      "name": "headings inside fenced code are not linkable",
      "title": null,
      "markdown": "```md\n## Hidden heading\n```\n\n## Visible heading\n",
      "expectedAnchors": [
        "visible-heading"
      ],
      "rejectedAnchors": [
        "hidden-heading"
      ]
    },
    {
      "name": "inline links and emphasis in rendered headings follow shared slug rules",
      "title": null,
      "markdown": "## Review [linked *power*](https://example.invalid) and **gain**\n",
      "expectedAnchors": [
        "review-linked-power-and-gain"
      ],
      "rejectedAnchors": [
