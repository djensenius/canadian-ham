    {
      "id": "timing-rejects-invalid-text",
      "input": {
        "text": "HI!",
        "profile": {
          "name": "isedParis"
        }
      },
      "expectedError": {
        "type": "invalidCharacters",
        "invalidCharacters": [
          {
            "character": "!",
            "index": 2
          }
        ]
      }
    },
    {
      "id": "timing-rejects-zero-character-speed",
      "input": {
        "text": "E",
        "profile": {
          "characterWpm": 0.0,
          "effectiveWpm": 5.0
        }
      },
      "expectedError": {
        "type": "invalidSpeed",
        "messageContains": "characterWpm"
      }
    },
    {
      "id": "timing-rejects-negative-effective-speed",
      "input": {
        "text": "E",
        "profile": {
          "characterWpm": 12.0,
          "effectiveWpm": -5.0
        }
      },
      "expectedError": {
        "type": "invalidSpeed",
        "messageContains": "effectiveWpm"
      }
    },
    {
      "id": "timing-rejects-nan-character-speed",
      "input": {
        "text": "E",
        "profile": {
          "characterWpm": "NaN",
          "effectiveWpm": 5.0
        }
      },
      "expectedError": {
        "type": "invalidSpeed",
