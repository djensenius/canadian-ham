{
  "schemaVersion": 1,
  "kind": "morse-validation",
  "cases": [
    {
      "id": "ric1-section-8-2-allows-letters-figures-and-five-punctuation-signs",
      "input": {
        "text": "ABCDEFGHIJKLMNOPQRSTUVWXYZ 0123456789 . , ? - /"
      },
      "expectedOutput": {
        "valid": true,
        "invalidCharacters": []
      }
    },
    {
      "id": "lowercase-ascii-letters-are-accepted",
      "input": {
        "text": "abc xyz"
      },
      "expectedOutput": {
        "valid": true,
        "invalidCharacters": []
      }
    },
    {
      "id": "accented-letters-are-rejected",
      "input": {
        "text": "CAFE É"
      },
      "expectedOutput": {
        "valid": false,
        "invalidCharacters": [
          {
            "character": "É",
            "index": 5
          }
        ]
      }
    },
    {
      "id": "decomposed-accent-reports-combining-mark-by-code-point-with-crlf",
      "input": {
        "text": "É\r\nA"
      },
      "expectedOutput": {
        "valid": false,
        "invalidCharacters": [
          {
            "character": "́",
            "index": 1
          }
        ]
      }
    },
    {
      "id": "non-ascii-characters-are-rejected-before-uppercasing",
      "input": {
        "text": "ı ſ"
      },
      "expectedOutput": {
        "valid": false,
        "invalidCharacters": [
          {
            "character": "ı",
            "index": 0
          },
          {
            "character": "ſ",
            "index": 2
          }
        ]
      }
    },
    {
      "id": "unsupported-prosign-symbols-are-rejected",
      "input": {
        "text": "SOS + AR"
      },
      "expectedOutput": {
        "valid": false,
        "invalidCharacters": [
          {
            "character": "+",
            "index": 4
          }
        ]
      }
    }
  ]
}
