    { "id": "toggle-sign-as-pending-operand", "keys": ["5", "+", "3", "±", "="], "expectedDisplay": "2" },
    { "id": "negative-square-root-errors", "keys": ["9", "±", "√"], "expectedDisplay": "Error" },
