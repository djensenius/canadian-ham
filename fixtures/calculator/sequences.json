    { "id": "repeat-equals-on-multiplication", "keys": ["3", "×", "4", "=", "="], "expectedDisplay": "48" },
    { "id": "repeat-equals-on-division", "keys": ["8", "÷", "2", "=", "="], "expectedDisplay": "2" },
    { "id": "digit-after-equals-starts-fresh", "keys": ["2", "+", "3", "=", "9"], "expectedDisplay": "9" },
    { "id": "operator-after-equals-continues-from-result", "keys": ["2", "+", "3", "=", "×", "4", "="], "expectedDisplay": "20" },
