    { "id": "percent-without-pending-operation", "keys": ["5", "0", "%"], "expectedDisplay": "0.5" },
    { "id": "percent-addition", "keys": ["2", "0", "0", "+", "1", "0", "%", "="], "expectedDisplay": "220" },
    { "id": "percent-subtraction", "keys": ["2", "0", "0", "-", "1", "0", "%", "="], "expectedDisplay": "180" },
    { "id": "percent-multiplication", "keys": ["2", "0", "0", "×", "1", "0", "%", "="], "expectedDisplay": "20" },
    { "id": "percent-division", "keys": ["2", "0", "0", "÷", "1", "0", "%", "="], "expectedDisplay": "2000" },
    { "id": "percent-repeat-equals", "keys": ["1", "0", "0", "+", "5", "%", "=", "="], "expectedDisplay": "110" },
    { "id": "divide-by-zero-errors", "keys": ["5", "÷", "0", "="], "expectedDisplay": "Error" },
