{
  "schemaVersion": 1,
  "kind": "calculator-sequences",
  "semantics": {
    "execution": "Immediate-execution basic calculator: chained binary operations evaluate left to right, so 2 + 3 × 4 = 20.",
    "repeatedEquals": "Pressing = again repeats the last binary operation with the same right operand.",
    "percent": "With + or -, % converts the displayed entry to that percentage of the left operand; with × or ÷, % converts the displayed entry to entry/100. Without a pending operation it also converts entry to entry/100.",
    "errors": "Divide by zero and square root of a negative value display Error; the next digit or AC starts a fresh calculation."
  },
  "cases": [
    { "id": "initial-display", "keys": [], "expectedDisplay": "0" },
    { "id": "single-zero", "keys": ["0"], "expectedDisplay": "0" },
    { "id": "leading-zeroes", "keys": ["0", "0", "7"], "expectedDisplay": "7" },
    { "id": "multi-digit-entry", "keys": ["1", "2", "3"], "expectedDisplay": "123" },
    { "id": "decimal-entry", "keys": ["1", ".", "2", "3"], "expectedDisplay": "1.23" },
    { "id": "leading-decimal-entry", "keys": [".", "5"], "expectedDisplay": "0.5" },
    { "id": "second-decimal-ignored", "keys": ["1", ".", ".", "2"], "expectedDisplay": "1.2" },
    { "id": "backspace-removes-last-digit", "keys": ["1", "2", "backspace"], "expectedDisplay": "1" },
    { "id": "backspace-to-zero", "keys": ["9", "backspace"], "expectedDisplay": "0" },
    { "id": "backspace-leaves-trailing-decimal", "keys": ["1", ".", "2", "backspace"], "expectedDisplay": "1." },
    { "id": "backspace-removes-decimal-point", "keys": ["1", ".", "backspace"], "expectedDisplay": "1" },
    { "id": "backspace-after-operator-noop", "keys": ["5", "+", "backspace"], "expectedDisplay": "5" },
    { "id": "clear-entry-during-entry", "keys": ["4", "5", "C/CE"], "expectedDisplay": "0" },
    { "id": "clear-entry-keeps-pending-operation", "keys": ["5", "+", "2", "C/CE", "3", "="], "expectedDisplay": "8" },
    { "id": "all-clear-resets-calculation", "keys": ["5", "+", "2", "AC", "3"], "expectedDisplay": "3" },
    { "id": "addition", "keys": ["2", "+", "3", "="], "expectedDisplay": "5" },
    { "id": "subtraction", "keys": ["9", "-", "4", "="], "expectedDisplay": "5" },
    { "id": "multiplication", "keys": ["6", "×", "7", "="], "expectedDisplay": "42" },
    { "id": "division", "keys": ["8", "÷", "2", "="], "expectedDisplay": "4" },
    { "id": "decimal-sum-rounds-cleanly", "keys": ["0", ".", "1", "+", "0", ".", "2", "="], "expectedDisplay": "0.3" },
    { "id": "near-zero-subtraction-rounds-cleanly", "keys": ["0", ".", "3", "-", "0", ".", "2", "-", "0", ".", "1", "="], "expectedDisplay": "0" },
    { "id": "left-to-right-plus-then-multiply", "keys": ["2", "+", "3", "×", "4", "="], "expectedDisplay": "20" },
    { "id": "left-to-right-divide-then-add", "keys": ["8", "÷", "2", "+", "3", "="], "expectedDisplay": "7" },
    { "id": "left-to-right-divide-then-multiply", "keys": ["8", "÷", "2", "×", "3", "="], "expectedDisplay": "12" },
    { "id": "left-to-right-repeated-subtract", "keys": ["9", "-", "3", "-", "2", "="], "expectedDisplay": "4" },
    { "id": "operator-replacement", "keys": ["5", "+", "-", "2", "="], "expectedDisplay": "3" },
    { "id": "equals-with-no-pending-operation", "keys": ["7", "="], "expectedDisplay": "7" },
    { "id": "equals-after-operator-uses-left-operand", "keys": ["2", "+", "="], "expectedDisplay": "4" },
    { "id": "repeat-equals-on-addition", "keys": ["2", "+", "3", "=", "="], "expectedDisplay": "8" },
