{
  "schemaVersion": 1,
  "kind": "calculator-sequences",
  "semantics": {
    "execution": "Immediate-execution basic calculator: chained binary operations evaluate left to right, so 2 + 3 × 4 = 20.",
    "repeatedEquals": "Pressing = again repeats the last binary operation with the same right operand.",
    "percent": "With + or -, % converts the displayed entry to that percentage of the left operand; with × or ÷, % converts the displayed entry to entry/100. Without a pending operation it also converts entry to entry/100.",
    "errors": "Divide by zero and square root of a negative value display Error; the next digit or AC starts a fresh calculation."
  },
  "cases": [
    {
      "id": "initial-display",
      "keys": [],
      "expectedDisplay": "0"
    },
